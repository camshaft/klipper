From: Copilot <copilot@github.com>
Date: Sun, 2 Feb 2026 02:00:00 +0000
Subject: [PATCH] Add non-critical MCU support with automatic reconnection

This patch adds support for marking MCUs as non-critical (via is_critical: False)
so they can disconnect/reconnect without halting prints. Useful for door sensors,
status displays, and monitoring peripherals.

Changes:
- New config option: is_critical (bool, default True)
- Primary MCU must be critical (enforced at config parse)
- Shutdown/timeout handlers bypass printer shutdown for non-critical MCUs
- Automatic reconnection timer with configurable reconnect_interval
- State tracking with is_connected() method
- UI event notifications: klippy:mcu_disconnected and klippy:mcu_reconnected
- Added disconnect() method to ClockSync for clean disconnection

Based on Kalico PR #339, adapted for current Klipper architecture.

Co-authored-by: camshaft <799311+camshaft@users.noreply.github.com>
---
 klippy/clocksync.py |   6 +++
 klippy/mcu.py       |  71 ++++++++++++++++++++++++++++++++++++++++++++-
 2 files changed, 76 insertions(+), 1 deletion(-)

diff --git a/klippy/clocksync.py b/klippy/clocksync.py
index 80ed9db..3baddc6 100644
--- a/klippy/clocksync.py
+++ b/klippy/clocksync.py
@@ -10,6 +10,7 @@ DECAY = 1. / 30.
 TRANSMIT_EXTRA = .001
 
 class ClockSync:
+    DISCONNECTED_QUERIES_PENDING = 999999
     def __init__(self, reactor):
         self.reactor = reactor
         self.serial = None
@@ -141,6 +142,11 @@ class ClockSync:
         return last_clock + clock_diff
     def is_active(self):
         return self.queries_pending <= 4
+    def disconnect(self):
+        # Mark clock sync as inactive by setting high queries_pending
+        self.queries_pending = self.DISCONNECTED_QUERIES_PENDING
+        # Cancel the periodic get_clock timer
+        self.reactor.update_timer(self.get_clock_timer, self.reactor.NEVER)
     def dump_debug(self):
         sample_time, clock, freq = self.clock_est
         return ("clocksync state: mcu_freq=%d last_clock=%d"
diff --git a/klippy/mcu.py b/klippy/mcu.py
index 909b8dd..7c67ce3 100644
--- a/klippy/mcu.py
+++ b/klippy/mcu.py
@@ -758,13 +758,19 @@ class MCUConnectHelper:
         shutdown_clock = params.get("clock")
         if shutdown_clock is not None:
             shutdown_clock = self._mcu.clock32_to_clock64(shutdown_clock)
+        # Skip shutdown notification for non-critical MCUs
+        if not self._mcu.is_critical():
+            logging.info("MCU '%s' shutdown: %s", self._name, msg)
+            self._mcu._handle_disconnect()
+            return
         event_type = params['#name']
         self._printer.invoke_async_shutdown(
             "MCU shutdown", {"reason": msg, "mcu": self._name,
                              "event_type": event_type,
                              "shutdown_clock": shutdown_clock})
     def _handle_starting(self, params):
-        if not self._is_shutdown:
+        # Skip spontaneous restart notification for non-critical MCUs
+        if not self._is_shutdown and self._mcu.is_critical():
             self._printer.invoke_async_shutdown("MCU '%s' spontaneous restart"
                                                 % (self._name,))
     def log_info(self):
@@ -839,6 +845,12 @@ class MCUConnectHelper:
             or self._is_timeout):
             return
         self._is_timeout = True
+        # Handle non-critical MCU timeout differently
+        if not self._mcu.is_critical():
+            logging.info("MCU '%s' timeout (eventtime=%f)",
+                         self._name, eventtime)
+            self._mcu._handle_disconnect()
+            return
         logging.info("Timeout with MCU '%s' (eventtime=%f)",
                      self._name, eventtime)
         self._printer.invoke_shutdown("Lost communication with MCU '%s'" % (
@@ -1074,6 +1086,18 @@ class MCU:
         self._name = config.get_name()
         if self._name.startswith('mcu '):
             self._name = self._name[4:]
+        # Critical MCU support (primary MCU is always critical)
+        self._is_critical = config.getboolean('is_critical', True)
+        if not self._is_critical and self._name == 'mcu':
+            raise config.error("Primary MCU must be marked as critical")
+        self._disconnected = False
+        # Keep reactor reference for potential use in reconnection logic
+        self._reactor = printer.get_reactor()
+        if not self._is_critical:
+            self._reconnect_timer = self._reactor.register_timer(
+                self._reconnect_event, self._reactor.NEVER)
+            self._reconnect_interval = config.getfloat('reconnect_interval',
+                                                       2.0, above=0.)
         # Low-level connection and helpers
         self._conn_helper = MCUConnectHelper(config, self, clocksync)
         self._serial = self._conn_helper.get_serial()
@@ -1091,6 +1115,45 @@ class MCU:
         return self._printer
     def is_fileoutput(self):
         return self._printer.get_start_args().get('debugoutput') is not None
+    def is_critical(self):
+        return self._is_critical
+    def is_connected(self):
+        return not self._disconnected
+    def _reconnect_event(self, eventtime):
+        # Attempt to reconnect a non-critical MCU
+        if self._is_critical or not self._disconnected:
+            return self._reactor.NEVER
+        try:
+            # Try to reattach
+            self._conn_helper._attach()
+            # Reconnect clocksync
+            self._clocksync.connect(self._serial)
+            # Reset is_shutdown and is_timeout flags in conn_helper
+            self._conn_helper._is_shutdown = False
+            self._conn_helper._is_timeout = False
+            # Mark as connected
+            self._disconnected = False
+            logging.info("MCU '%s' reconnected", self._name)
+            # Send event to notify UI
+            self._printer.send_event("klippy:mcu_reconnected", self._name)
+            return self._reactor.NEVER
+        except (serialhdl.error, OSError) as e:
+            # Reconnection failed, try again later
+            logging.debug("MCU '%s' reconnection failed: %s",
+                         self._name, str(e))
+            return eventtime + self._reconnect_interval
+    def _handle_disconnect(self):
+        # Called when a non-critical MCU disconnects
+        if self._is_critical:
+            return
+        self._disconnected = True
+        self._clocksync.disconnect()
+        logging.info("MCU '%s' disconnected", self._name)
+        # Send event to notify UI
+        self._printer.send_event("klippy:mcu_disconnected", self._name)
+        # Schedule reconnection attempts
+        self._reactor.update_timer(self._reconnect_timer,
+                                   self._reactor.NOW)
     # MCU Configuration wrappers
     def setup_pin(self, pin_type, pin_params):
         return self._config_helper.setup_pin(pin_type, pin_params)

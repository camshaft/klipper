From: Copilot <copilot@github.com>
Date: Sun, 2 Feb 2026 04:00:00 +0000
Subject: [PATCH] Add pyproject.toml for modern Python dependency management

This patch adds a PEP 517/518-compliant pyproject.toml file to simplify
development setup and dependency management for Klipper.

Changes:
- New pyproject.toml with project metadata and all dependencies
- Core runtime dependencies from klippy-requirements.txt
- Optional dependency groups: test, graphing, docs, dev
- Updated .gitignore to exclude Python build artifacts

Benefits:
- Easy setup: pip install -e .
- Optional features: pip install -e ".[dev]"
- Better integration with modern Python tooling
- Maintains backward compatibility with existing requirements files

Co-authored-by: camshaft <799311+camshaft@users.noreply.github.com>
---
diff --git a/.gitignore b/.gitignore
index f952167..17eb9b1 100644
--- a/.gitignore
+++ b/.gitignore
@@ -4,3 +4,8 @@ out
 .config
 .config.old
 klippy/.version
+# Python packaging artifacts
+*.egg-info/
+dist/
+build/
+__pycache__/
diff --git a/pyproject.toml b/pyproject.toml
new file mode 100644
index 0000000..6ffbdda
--- /dev/null
+++ b/pyproject.toml
@@ -0,0 +1,92 @@
+[build-system]
+requires = ["setuptools>=45", "wheel", "setuptools-scm[toml]>=6.2"]
+build-backend = "setuptools.build_meta"
+
+[project]
+name = "klipper"
+version = "0.12.0"
+description = "Klipper is a 3d-Printer firmware. It combines the power of a general purpose computer with one or more micro-controllers."
+readme = "README.md"
+requires-python = ">=3.7"
+license = {text = "GPL-3.0-or-later"}
+authors = [
+    {name = "Kevin O'Connor", email = "kevin@koconnor.net"}
+]
+keywords = ["3d-printer", "firmware", "klipper", "3d-printing"]
+classifiers = [
+    "Development Status :: 4 - Beta",
+    "Intended Audience :: Manufacturing",
+    "Topic :: System :: Hardware",
+    "License :: OSI Approved :: GNU General Public License v3 or later (GPLv3+)",
+    "Programming Language :: Python :: 3",
+    "Programming Language :: Python :: 3.7",
+    "Programming Language :: Python :: 3.8",
+    "Programming Language :: Python :: 3.9",
+    "Programming Language :: Python :: 3.10",
+    "Programming Language :: Python :: 3.11",
+    "Programming Language :: Python :: 3.12",
+]
+
+# Core runtime dependencies for the Klipper host software (klippy)
+dependencies = [
+    # greenlet is used by the reactor.py code
+    "greenlet==2.0.2 ; python_version < '3.12'",
+    "greenlet==3.1.1 ; python_version >= '3.12'",
+    # cffi is used by "chelper" code and by greenlet
+    "cffi==1.14.6 ; python_version < '3.12'",
+    "cffi==1.17.1 ; python_version >= '3.12'",
+    # Jinja2 is used by gcode_macro.py
+    "Jinja2==2.11.3",
+    "markupsafe==1.1.1",  # Needed by Jinja2
+    # pyserial is used by serialhdl.py (for USB and UART mcu connections)
+    "pyserial==3.4",
+    # python-can is used by serialhdl.py (for canbus mcu connections)
+    "python-can==3.3.4",
+    "setuptools==78.1.1 ; python_version >= '3.12'",  # Needed by python-can
+    # msgspec is an optional dependency of webhooks.py
+    "msgspec==0.19.0 ; python_version >= '3.9'",
+]
+
+[project.optional-dependencies]
+# Testing dependencies
+test = [
+    # scipy is used for regression tests
+    "scipy>=1.2.0",
+]
+
+# Graphing and analysis tools (for calibration and debugging scripts)
+graphing = [
+    "numpy>=1.19.0",
+    "matplotlib>=3.0.0",
+]
+
+# Documentation building dependencies
+docs = [
+    "mkdocs==1.2.4",
+    "mkdocs-material==8.1.3",
+    "mkdocs-simple-hooks==0.1.3",
+    "mkdocs-exclude==1.0.2",
+    "mdx-truly-sane-lists==1.2",
+    "mdx-breakless-lists==1.0.1",
+    "py-gfm==1.0.2",
+    "markdown==3.3.7",
+]
+
+# All development dependencies combined
+dev = [
+    "klipper[test,graphing,docs]",
+]
+
+[project.urls]
+Homepage = "https://www.klipper3d.org/"
+Documentation = "https://www.klipper3d.org/Overview.html"
+Repository = "https://github.com/Klipper3d/klipper"
+"Bug Tracker" = "https://github.com/Klipper3d/klipper/issues"
+
+[tool.setuptools]
+# Automatically discover all packages under klippy
+packages = {find = {where = ["."], include = ["klippy*"]}}
+
+[tool.setuptools.package-data]
+# Include all Python files in the klippy package
+"*" = ["*.py"]

From 1364584743b91ec4a580c28683ac45a09e2dac97 Mon Sep 17 00:00:00 2001
From: Cameron Bytheway <bytheway.cameron@gmail.com>
Date: Mon, 2 Feb 2026 15:47:54 -0700
Subject: [PATCH] neopixel: increase MAX_MCU_SIZE to 768

Increase the maximum neopixel chain size from 500 to 768 bytes.
This allows up to 192 RGB LEDs or 192 RGBW LEDs (768/4=192).

The default limit of 500 bytes restricts RGBW strips to 125 LEDs,
which is insufficient for chamber lighting applications that may
use 144+ LED strips.
---
 klippy/extras/neopixel.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/klippy/extras/neopixel.py b/klippy/extras/neopixel.py
index b160fc2f..4fcfef73 100644
--- a/klippy/extras/neopixel.py
+++ b/klippy/extras/neopixel.py
@@ -11,7 +11,7 @@ BACKGROUND_PRIORITY_CLOCK = 0x7fffffff00000000
 BIT_MAX_TIME=.000004
 RESET_MIN_TIME=.000050
 
-MAX_MCU_SIZE = 500  # Sanity check on LED chain length
+MAX_MCU_SIZE = 768  # Sanity check on LED chain length
 
 class PrinterNeoPixel:
     def __init__(self, config):
-- 
2.50.1

